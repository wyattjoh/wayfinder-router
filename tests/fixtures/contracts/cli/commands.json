{
  "description": "Static Python-derived CLI command surface contracts.",
  "commands": [
    {
      "name": "serve",
      "surface": "gateway",
      "argv": ["serve", "--host", "127.0.0.1", "--port", "8088", "--dry-run", "--timeout", "60"],
      "expected": {
        "ok": true,
        "stdout_lines": ["wayfinder-router serve listening on http://127.0.0.1:8088 (dry-run, 60s timeout)"],
        "stderr_lines": []
      }
    },
    {
      "name": "chat",
      "surface": "tui",
      "argv": ["chat", "--theme", "auto", "--threshold", "0.5", "--why", "--dry-run", "--no-stream", "--base-url", "http://127.0.0.1:8088"],
      "expected": {
        "ok": true,
        "stdout_lines": [
          "wayfinder-router chat",
          "dry-run: true",
          "theme: auto",
          "stream: false",
          "gateway: skipped",
          "key status: not checked",
          "input: enter a prompt on stdin or pass prompt text after chat",
          "commands: /why /route /local /cloud /auto /threads /load <id> /save <id>"
        ],
        "stderr_lines": []
      }
    },
    {
      "name": "route-json",
      "surface": "route",
      "argv": ["route", "-", "--json"],
      "stdin": "Say hello.",
      "expected": {
        "ok": true,
        "stdout_json": {
          "schema_version": "3",
          "score": 0.0,
          "recommendation": "local",
          "mode": "tiered",
          "features": {
            "word_count": 2,
            "heading_count": 0,
            "max_heading_depth": 0,
            "list_item_count": 0,
            "link_count": 0,
            "code_block_count": 0,
            "table_row_count": 0,
            "reasoning_term_count": 0,
            "math_symbol_count": 0,
            "constraint_term_count": 0,
            "question_count": 0
          },
          "tiers": [
            { "min_score": 0.0, "model": "local" },
            { "min_score": 0.5, "model": "cloud" }
          ]
        },
        "stderr_lines": []
      }
    },
    {
      "name": "calibrate-threshold",
      "surface": "calibrate",
      "dataset_fixture": "calibrate/threshold-accuracy.json",
      "argv": ["calibrate", "<dataset>", "--mode", "threshold"],
      "expected": {
        "ok": true,
        "stdout_lines": [
          "[[routing.tiers]]",
          "min_score = 0.0",
          "model = \"local\"",
          "",
          "[[routing.tiers]]",
          "min_score = 0.49",
          "model = \"cloud\"",
          ""
        ],
        "stdout_trailing_newline": true,
        "stderr_lines": ["wayfinder-router: mode=threshold, threshold=0.49, models=['local', 'cloud'], accuracy=1.0, samples=10"],
        "stderr_trailing_newline": true
      }
    },
    {
      "name": "init-print",
      "surface": "init",
      "argv": ["init", "--preset", "openai", "--print"],
      "expected": {
        "ok": true,
        "stdout_lines": [
          "# wayfinder-router.toml \u2014 generated by `wayfinder-router init --preset openai`.",
          "#",
          "# Wayfinder never stores secrets: a model names an env var (api_key_env) and the key",
          "# is read from your environment at request time (WF-ADR-0004). Edit this file freely;",
          "# re-run `wayfinder-router doctor` to check your setup.",
          "",
          "# Two cost tiers from one provider: prompts scoring below the cut use the small model;",
          "# at or above it they escalate to the large one. Tune cuts with `wayfinder-router calibrate`.",
          "[[routing.tiers]]",
          "min_score = 0.0",
          "model = \"small\"",
          "",
          "[[routing.tiers]]",
          "min_score = 0.08",
          "model = \"large\"",
          "",
          "# Small (cheap) arm.",
          "[gateway.models.small]",
          "base_url = \"https://api.openai.com/v1\"",
          "model = \"gpt-4o-mini\"",
          "api_key_env = \"OPENAI_API_KEY\"",
          "cost_per_1k = 0.0004   # rough $/1k tokens (blended) \u2014 edit for your pricing",
          "",
          "# Large (capable) arm \u2014 same key, read from the environment at request time.",
          "[gateway.models.large]",
          "base_url = \"https://api.openai.com/v1\"",
          "model = \"gpt-4o\"",
          "api_key_env = \"OPENAI_API_KEY\"",
          "cost_per_1k = 0.0075   # rough $/1k tokens (blended) \u2014 edit for your pricing"
        ],
        "stdout_trailing_newline": true,
        "stderr_lines": []
      }
    },
    {
      "name": "doctor-keyless",
      "surface": "doctor",
      "argv": ["doctor", "--dir", "<tempdir>"],
      "config": "[routing]\nthreshold = 0.08\n\n[gateway.models.local]\nbase_url = \"http://localhost:11434/v1\"\nmodel = \"llama3.1\"\n",
      "expected": {
        "ok": true,
        "stdout_lines": [
          "config:  <tempdir>/wayfinder-router.toml",
          "routing: local \u22650.00 \u00b7 cloud \u22650.08",
          "",
          "models",
          "  local   llama3.1                 http://localhost:11434/v1      keyless \u2713",
          "",
          "ready:  wayfinder-router chat"
        ],
        "stdout_trailing_newline": true,
        "stderr_lines": []
      }
    },
    {
      "name": "keys-new",
      "surface": "keys",
      "argv": ["keys", "new", "--id", "team-a", "--tag", "prod"],
      "expected": {
        "ok": true,
        "stdout_lines": [
          "# Paste into wayfinder-router.toml (only the hash is stored \u2014 never the key):",
          "[gateway.keys.team-a]",
          "hash = \"<generated-key-hash>\"",
          "tags = [\"prod\"]",
          "",
          "# Give this key to the caller; it is shown once and cannot be recovered:",
          "<generated-key>"
        ],
        "stdout_trailing_newline": true,
        "stderr_lines": [],
        "verify_generated_key": true
      }
    }
  ]
}
